# The packaged systemd unit stops Nomad with SIGINT, so leave gracefully on
# both signals.
leave_on_interrupt = true
leave_on_terminate = true

limits {
  http_max_conns_per_client = ${http_max_conns_per_client}
}

server {
  enabled          = true
  bootstrap_expect = ${bootstrap_expect}

  # Dead periodic and batch child jobs, with their evals and allocs, stay
  # visible until job_gc_threshold passes.
  job_gc_threshold        = "${job_gc_threshold}"
  eval_gc_threshold       = "${eval_gc_threshold}"
  batch_eval_gc_threshold = "${batch_eval_gc_threshold}"
  deployment_gc_threshold = "${deployment_gc_threshold}"

  # Marks a node ineligible after repeated plan rejections instead of letting
  # the scheduler keep placing work on it.
  plan_rejection_tracker {
    enabled = true
  }

  server_join {
    retry_join = ["provider=aws region=${aws_region} tag_key=${join_tag_key} tag_value=${join_tag_value}"]
  }

  default_scheduler_config {
    memory_oversubscription_enabled = ${memory_oversubscription_enabled}
  }
}
%{ if ui_label != "" ~}

ui {
  label {
    text = ${jsonencode(ui_label)}
  }
}
%{ endif ~}
